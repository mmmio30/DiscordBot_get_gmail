# Bot 本体。/root/discord-bot に配置する前提。
# 別の場所に置く場合は WorkingDirectory と ExecStart を書き換えること。
[Unit]
Description=Discord Gmail OTP Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/discord-bot
ExecStart=/usr/bin/python3 /root/discord-bot/main.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
