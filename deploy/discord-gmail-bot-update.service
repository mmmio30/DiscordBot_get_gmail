# タイマーから呼ばれる更新処理。単体で叩けば任意のタイミングでも更新できる:
#   systemctl start discord-gmail-bot-update.service
[Unit]
Description=Discord Gmail OTP Bot の自動更新
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/discord-bot
ExecStart=/root/discord-bot/deploy/auto_update.sh
